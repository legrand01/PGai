{
  "name": "PGai",
  "version": "0.1.0",
  "description": "PostgreSQL monitoring and tuning capabilities similar to dbtune but with additional AI-powered features",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x build/index.js",
    "watch": "tsc -w",
    "test": "echo \"Error: no test specified\" && exit 1",
    "start:mcp": "node build/index.js",
    "start:dashboard": "node dashboard/server.js",
    "start": "concurrently \"npm run start:mcp\" \"npm run start:dashboard\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "axios": "^1.6.5",
    "concurrently": "^8.2.2",
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "systeminformation": "^5.21.22"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/pg": "^8.10.9",
    "typescript": "^5.3.3"
  }
}
